{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EL-Rouji Public Product",
  "description": "Provider-neutral product representation. Passing this schema is structural validation only; publication policy is enforced by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "description",
    "status",
    "currency",
    "priceMinor",
    "availability"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217-style code shape only; server configuration must validate the actual supported currency."
    },
    "priceMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000,
      "description": "Integer minor units. Server recalculates and revalidates commercial amounts at checkout."
    },
    "availability": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "preorder",
        "unknown"
      ]
    },
    "categoryIds": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "media": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId",
          "altText"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "altText": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sku",
          "label",
          "priceMinor",
          "availability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "priceMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "availability": {
            "type": "string",
            "enum": [
              "in_stock",
              "out_of_stock",
              "preorder",
              "unknown"
            ]
          },
          "options": {
            "type": "object",
            "maxProperties": 20,
            "propertyNames": {
              "maxLength": 80
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 180
            }
          }
        }
      }
    }
  }
}
